<%# Replaced wholesale by Receipts::LinksController after a confirm/dismiss/unlink: a decision
    usually moves the row out of the active status filter, so re-querying beats patching the row. %>
<div id="receipts_list">
  <% if @receipt_links.blank? %>
    <%= render "receipts/empty", configured: @paperless_connection.present? %>
  <% else %>
    <% filters = { status: @status, source: @source, page: params[:page].presence }.compact %>
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="text-xs uppercase font-medium text-secondary border-b border-divider">
            <th class="px-3 py-3 text-left min-w-64"><%= t(".header.document") %></th>
            <th class="px-3 py-3 text-left min-w-36"><%= t(".header.recipient") %></th>
            <th class="px-3 py-3 text-left min-w-44"><%= t(".header.transaction") %></th>
            <th class="px-3 py-3 text-left min-w-28"><%= t(".header.status") %></th>
            <th class="px-3 py-3 text-right min-w-32"><%= t(".header.actions") %></th>
          </tr>
        </thead>
        <tbody>
          <%= render partial: "receipts/row",
                collection: @receipt_links,
                as: :receipt_link,
                locals: { filters: filters } %>
        </tbody>
      </table>
    </div>

    <% if @pagy.pages > 1 %>
      <div class="p-4 border-t border-subdued">
        <%= render "shared/pagination", pagy: @pagy %>
      </div>
    <% end %>
  <% end %>
</div>
