<%= render DS::Dialog.new(variant: "modal") do |dialog| %>
  <% dialog.with_header(title: @account ? t(".title_for_account", account: @account.name) : t(".title")) %>

  <% dialog.with_body do %>
    <%= form_with url: new_account_statements_paperless_import_path, method: :get,
          data: { turbo_frame: "paperless_statement_search_results" },
          class: "mb-4" do %>
      <%= hidden_field_tag :account_id, @account&.id %>
      <%= render DS::SearchInput.new(name: "q", value: @query, placeholder: t(".search_placeholder")) %>
    <% end %>

    <%= turbo_frame_tag "paperless_statement_search_results", class: "block max-h-[420px] overflow-y-auto -mx-1 px-1" do %>
      <%= render "account_statements/paperless_imports/search_results",
            account: @account,
            query: @query,
            documents: @documents,
            correspondents: @correspondents,
            imported_statement_ids: @imported_statement_ids,
            next_page: @next_page,
            error_message: @search_error_message %>
    <% end %>
  <% end %>
<% end %>
