<%= render DS::Dialog.new(variant: "modal", width: "xl", scrollable: false) do |dialog| %>
  <% dialog.with_header(title: @receipt_link&.document_title.presence || t(".fallback_title")) %>

  <% dialog.with_body do %>
    <div class="flex flex-col gap-3">
      <%# A flex-1/h-full chain here can't resolve to a real pixel height: the dialog centers
          this card on its cross axis (items-center) rather than stretching it, so every
          ancestor up to the dialog is auto/content-sized and there's no percentage height to
          inherit. Give the embed box its own definite height instead. %>
      <div class="h-[70vh] rounded-lg overflow-hidden bg-surface-inset" data-controller="paperless-document-preview">
        <% if @receipt_link&.image? %>
          <%= image_tag preview_paperless_document_path(@document_id),
                class: "w-full h-full object-contain",
                alt: t(".preview_alt", title: @receipt_link.document_title.presence || t(".fallback_title")),
                data: { paperless_document_preview_target: "image", action: "error->paperless-document-preview#fallbackToFrame" } %>
        <% else %>
          <%= tag.iframe src: preview_paperless_document_path(@document_id),
                class: "w-full h-full",
                title: @receipt_link&.document_title.presence || t(".fallback_title") %>
        <% end %>
      </div>

      <div class="flex items-center justify-end gap-2">
        <%= render DS::Link.new(
              href: download_paperless_document_path(@document_id),
              variant: :outline,
              size: :sm,
              icon: "download",
              text: t(".download"),
              data: { turbo: false }
            ) %>
        <%= render DS::Link.new(
              href: @paperless_connection.document_url(@document_id),
              variant: :outline,
              size: :sm,
              icon: "external-link",
              text: t(".open_in_paperless"),
              target: "_blank"
            ) %>
      </div>
    </div>
  <% end %>
<% end %>
