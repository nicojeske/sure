<%# A headline figure on the summary page. %>
<%# locals: (label:, icon:, value:) %>
<div class="min-w-0">
  <p class="flex items-center gap-1.5 text-sm text-secondary"><%= icon(icon, size: "sm") %><%= label %></p>
  <p class="mt-1 truncate text-2xl font-semibold text-primary privacy-sensitive"><%= value %></p>
</div>
