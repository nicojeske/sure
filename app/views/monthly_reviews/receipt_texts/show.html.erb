<%= turbo_frame_tag review_receipt_frame_id(@variant, @receipt_link), data: { turbo_permanent: true } do %>
  <% if @failed %>
    <%= render DS::Inset.new(tag: :p, text_size: :xs, data: { review_receipt_error: true }).with_content(t(".failed")) %>
  <% elsif @content.blank? %>
    <%= render DS::Inset.new(tag: :p, text_size: :xs).with_content(t(".empty")) %>
  <% else %>
    <%= render DS::Inset.new(scroll_label: t(".label"), class: review_receipt_scroll_class(@variant), data: { receipt_scroll: true }) do %>
      <pre class="whitespace-pre-wrap break-words font-mono text-xs text-primary"><%= @content %></pre>
    <% end %>
  <% end %>
<% end %>
