<%# Queue status dot, coloured by the data-status of the nearest group/item. %>
<span class="size-2 shrink-0 rounded-full border border-secondary bg-container-inset group-data-[status=reviewed]/item:border-transparent group-data-[status=reviewed]/item:bg-success group-data-[status=skipped]/item:border-transparent group-data-[status=skipped]/item:bg-warning group-data-[status=current]/item:border-transparent group-data-[status=current]/item:bg-inverse" aria-hidden="true"></span>
