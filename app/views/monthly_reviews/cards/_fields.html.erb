<%# All five rows, always and in the same order, so nothing moves between
    cards. Only a row the proposal changes (and this user may change) has a
    checkbox; its number key toggles it. %>
<%# locals: (card:, form_id:) %>
<div class="flex flex-col divide-y divide-subdued rounded-lg border border-secondary">
  <% card.fields.each do |field| %>
    <%= content_tag (field.change? ? :label : :div),
          class: class_names("group/row grid grid-cols-[1.25rem_1.25rem_5rem_minmax(0,1fr)] items-center gap-x-2 px-3 py-1.5 text-sm", field.change? && "cursor-pointer"),
          data: { review_field_row: field.key, status: field.status } do %>
      <span class="flex items-center justify-center">
        <% case field.status %>
        <% when :change %>
          <%= check_box_tag "fields[]", field.key, field.checked,
                id: "review_field_#{field.key}", form: form_id, class: "checkbox checkbox--light",
                aria: { label: t(".apply", field: t(".labels.#{field.key}")) },
                data: { review_field: field.key } %>
        <% when :locked %>
          <%= icon "lock", size: "xs", title: t(".locked") %>
        <% when :applied %>
          <%= icon "check", size: "sm", color: "success" %>
        <% end %>
      </span>
      <span class="<%= "opacity-50" unless field.change? %>"><%= render "monthly_reviews/cards/kbd", key: field.number %></span>
      <span class="text-xs text-secondary"><%= t(".labels.#{field.key}") %></span>
      <span class="flex min-w-0 flex-col">
        <% if field.status.in?(%i[change locked]) %>
          <span class="truncate text-xs text-subdued group-has-[:checked]/row:line-through">
            <%= render "monthly_reviews/cards/field_value", key: field.key, value: field.current, entry: card.entry %>
          </span>
          <span class="flex min-w-0 items-center gap-1 text-subdued group-has-[:checked]/row:text-primary">
            <span aria-hidden="true">→</span>
            <%= render "monthly_reviews/cards/field_value", key: field.key, value: field.proposed, entry: card.entry %>
          </span>
        <% else %>
          <span class="truncate text-primary">
            <%= render "monthly_reviews/cards/field_value", key: field.key, value: field.current, entry: card.entry %>
          </span>
          <span class="text-xs text-subdued"><%= field.status == :applied ? t(".applied") : t(".no_change") %></span>
        <% end %>
      </span>
    <% end %>
  <% end %>
</div>
