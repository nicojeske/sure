<% content_for :title, t(".title", month: review_month_label(@monthly_review)) %>

<%= tag.div class: "@container/page pb-48 md:pb-12",
      data: {
        controller: "review-card",
        action: "keydown@document->review-card#key",
        review_card_messages_value: {
          nothing_proposed: t(".messages.nothing_proposed"),
          nothing_to_undo: t(".messages.nothing_to_undo"),
          no_receipt: t(".messages.no_receipt"),
          first_card: t(".messages.first_card"),
          still_reading: t(".messages.still_reading")
        }.to_json
      } do %>
  <%= render DS::PageHeader.new(title: t(".heading", month: review_month_label(@monthly_review)), preview: true, size: :md, class: "mb-4") do |header| %>
    <% header.with_action do %>
      <%= render "monthly_reviews/transfers_toggle", href: monthly_review_card_path(@monthly_review, include_transfers: (include_transfers? ? nil : "1")) %>
    <% end %>
    <% header.with_action do %>
      <%= render DS::Link.new(
            text: t(".summary"),
            variant: :ghost,
            size: :sm,
            icon: "clipboard-list",
            href: monthly_review_path(@monthly_review, transfers_param)
          ) %>
    <% end %>
    <% header.with_action do %>
      <%= render DS::Button.new(
            text: t(".refresh"),
            variant: :outline,
            size: :sm,
            icon: "refresh-cw",
            href: monthly_review_prefetch_path(@monthly_review, include_transfers: ("1" if include_transfers?)),
            method: :post,
            title: t(".refresh_hint")
          ) %>
    <% end %>
  <% end %>

  <div class="grid grid-cols-1 @3xl/page:grid-cols-[18rem_minmax(0,1fr)] @7xl/page:grid-cols-[18rem_minmax(0,1fr)_24rem] gap-4 items-start">
    <%= render "monthly_reviews/cards/list", list: @list, current_entry: @entry %>

    <%= turbo_frame_tag "monthly_review_card",
          class: "group/frame contents",
          data: { turbo_action: "advance", action: "turbo:frame-missing->review-card#leaveFrame" } do %>
      <%= turbo_stream_from Current.family, :monthly_review, @entry, hidden: true %>
      <%= render "monthly_reviews/cards/strip", list: @list, current_entry: @entry %>
      <%= render "monthly_reviews/cards/card", card: @card, list: @list %>
      <aside class="hidden @7xl/page:col-start-3 @7xl/page:block sticky top-4" aria-label="<%= t(".receipt_column") %>">
        <%= render DS::Card.new do %>
          <%= render "monthly_reviews/cards/receipt_pane", card: @card, variant: "wide" %>
        <% end %>
      </aside>
    <% end %>
  </div>
<% end %>
