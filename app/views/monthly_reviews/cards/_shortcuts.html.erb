<% keys = [
     [ "/ h", "hint" ], [ "⏎", "accept" ], [ "#{t("monthly_reviews.cards.keys.ctrl")}+⏎", "reviewed" ], [ t("monthly_reviews.cards.keys.esc"), "skip" ],
     [ "#{t("monthly_reviews.cards.keys.alt")}+←", "back" ], [ "1–5", "fields" ], [ "x", "split" ], [ "f", "find" ], [ "o", "open" ], [ "t", "text" ], [ "e", "edit" ],
     [ "u", "undo" ], [ "r", "rule" ], [ "⇧R", "rule_dismiss" ], [ "n", "rule_never" ], [ "b", "bill" ], [ "⇧B", "bill_dismiss" ], [ t("monthly_reviews.cards.keys.scroll"), "scroll" ]
   ] %>
<div class="hidden flex-wrap items-center gap-x-3 gap-y-1 text-xs text-secondary md:flex" aria-label="<%= t(".label") %>">
  <% keys.each do |key, action| %>
    <span class="inline-flex items-center gap-1"><%= render DS::Kbd.new(key: key) %><%= t(".#{action}") %></span>
  <% end %>
</div>
