<%# The month's transactions beside the card. It sits outside the card's frame,
    so it keeps its scroll position; the review-card controller repaints the
    status dots after each card. %>
<%# locals: (list:, current_entry:) %>
<div class="hidden @3xl/page:block sticky top-4">
  <%= render DS::Card.new(class: "gap-2") do %>
    <div class="flex items-center justify-between text-xs text-secondary">
      <span class="font-medium text-primary"><%= t(".title") %></span>
      <span><%= t(".progress_html", reviewed: tag.span(list.reviewed_ids.size, data: { review_reviewed_count: true }), total: list.size) %></span>
    </div>
    <ol class="-mx-5 -mb-5 max-h-[75vh] overflow-y-auto divide-y divide-subdued border-t border-primary" data-review-card-target="list">
      <% list.each do |entry| %>
        <%= render "monthly_reviews/cards/list_row", entry: entry, status: list.status(entry, current_entry), rule_handled: list.rule_handled?(entry) %>
      <% end %>
    </ol>
  <% end %>
</div>
