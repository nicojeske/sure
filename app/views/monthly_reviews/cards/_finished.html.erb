<%# The end of the queue. Skipped transactions are still unreviewed: starting
    over goes through them. The month's note and completion are on the
    summary page. %>
<%# locals: (list:) %>
<% reviewed = list.reviewed_ids.size %>
<% skipped = list.size - reviewed %>
<%= render DS::Card.new(
      class: "@3xl/page:col-start-2 @7xl/page:col-span-2",
      data: { review_card_target: "card", review_card_state: "finished", review_card_total: list.size, review_card_reviewed_ids: list.reviewed_ids.to_json }
    ) do %>
  <%= render DS::EmptyState.new(
        icon: "circle-check",
        title: t(".title", month: review_month_label(@monthly_review)),
        description: [ t(".summary", reviewed: reviewed, total: list.size), (t(".skipped", count: skipped) if skipped.positive?) ].compact.join(" ")
      ) do |state| %>
    <% state.with_action do %>
      <div class="flex flex-wrap justify-center gap-2">
        <% if skipped.positive? %>
          <%= render DS::Link.new(text: t(".restart"), variant: :outline, href: review_card_path, data: { turbo_frame: "monthly_review_card", turbo_action: "advance" }) %>
        <% end %>
        <%= render DS::Link.new(text: t(".summary_link"), icon: "clipboard-list", href: monthly_review_path(@monthly_review, transfers_param), data: { turbo_frame: "_top" }) %>
      </div>
    <% end %>
  <% end %>
<% end %>
