<%# locals: (card:, position:, total:) %>
<% entry = card.entry %>
<div class="flex items-start justify-between gap-3">
  <div class="flex min-w-0 items-start gap-3">
    <%= render "monthly_reviews/cards/merchant_avatar", merchant: card.transaction.merchant, name: entry.name %>
    <div class="min-w-0">
      <p class="text-xs text-secondary"><%= t(".meta", date: l(entry.date, format: :long), account: entry.account.name, position: position, total: total) %></p>
      <h2 class="truncate text-lg font-medium text-primary"><%= entry.name %></h2>
      <% if card.original_name %>
        <p class="truncate font-mono text-xs text-subdued"><%= t(".original_name", name: card.original_name) %></p>
      <% end %>
      <% if card.rule_handled? %>
        <div class="mt-1" data-review-rule-badge>
          <%= render "monthly_reviews/cards/rule_marker", rule: card.rule, label: t(".rule") %>
        </div>
      <% end %>
    </div>
  </div>
  <p class="shrink-0 text-lg font-medium text-primary privacy-sensitive"><%= format_money(-entry.amount_money) %></p>
</div>
