<%# The bill this entry belongs to, or a detected series to confirm or
    dismiss. The buttons post to the recurring series' own confirm and
    dismiss, which redirect back to this card. %>
<%# locals: (suggestion:, card:) %>
<% series = suggestion.series %>
<% amount = tag.span(format_money(series.amount_money.abs), class: "privacy-sensitive") %>
<% text = suggestion.active? ? t(".active_html", name: series.display_name, amount: amount) : t(".suggested_html", name: series.display_name, amount: amount) %>
<%= render layout: "monthly_reviews/cards/suggestions/row", locals: { icon: "calendar-clock", text: text, data: { review_bill: series.status } } do %>
  <% if suggestion.suggested? %>
    <%= render DS::Button.new(
          text: t(".confirm"),
          variant: :outline,
          size: :sm,
          href: confirm_recurring_transaction_path(series),
          method: :post,
          data: { review_suggestion: "bill", review_suggestion_action: "accept" }
        ) %>
    <%= render DS::Button.new(
          text: t(".dismiss"),
          variant: :ghost,
          size: :sm,
          href: dismiss_recurring_transaction_path(series),
          method: :post,
          data: { review_suggestion: "bill", review_suggestion_action: "dismiss" }
        ) %>
  <% end %>
<% end %>
